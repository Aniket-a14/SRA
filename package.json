{
    "name": "sra-monorepo",
    "version": "4.2.0",
    "private": true,
    "description": "SRA Monorepo - Frontend, Backend, and CLI",
    "scripts": {
        "dev": "pnpm --filter frontend dev",
        "dev:frontend": "pnpm --filter frontend dev",
        "dev:backend": "pnpm --filter backend dev",
        "dev:all": "pnpm -r dev",
        "install:all": "pnpm install",
        "build:frontend": "pnpm --filter frontend build",
        "test:backend": "pnpm --filter backend test",
        "test:cli": "pnpm --filter @sra-srs/sra-cli test",
        "test:all": "pnpm --filter backend test && pnpm --filter @sra-srs/sra-cli test",
        "lint:all": "pnpm -r lint"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "resolutions": {
        "prisma": "7.9.0",
        "@prisma/client": "7.9.0",
        "@prisma/adapter-pg": "7.9.0",
        "@prisma/client-runtime-utils": "7.9.0"
    },
    "author": "SRA Team",
    "license": "ISC",
    "dependencies": {
        "pdf-parse": "^2.4.5",
        "pdfjs-dist": "^6.2.108"
    }
}
