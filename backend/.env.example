# Upstash QStash
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_next_signing_key

# Database
DATABASE_URL=postgresql://user:password@host:port/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:port/dbname

# App Configuration
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
PORT=3000
NODE_ENV=development
AI_NAME=SRA
# Comma-separated list of allowed origins for CORS/CSP (Production)
ALLOWED_ORIGINS=https://sra-xi.vercel.app,http://localhost:3000

# Auth - Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Auth - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# AI Keys
# Gemini is the only provider with a platform-wide key, and it is used for EMBEDDINGS
# ONLY — generation is bring-your-own-key for every provider, Gemini included (see
# Settings > AI Providers in the app). OPENAI_API_KEY/ANTHROPIC_API_KEY below are NOT
# read as platform-wide fallbacks, only the *_MODEL_NAME defaults are.
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- Model ids -------------------------------------------------------------------
# No model id is hardcoded anywhere in src/ (see backend/src/config/models.js). Providers
# retire models without notice, so changing one is an env edit + restart, not a code change.
# Values below were verified callable on a FREE-tier Gemini key on 2026-07-25 by listing
# models and actually invoking each one. Note that on the free tier every *-pro Gemini
# model returns 429 (no free quota), and gemini-2.5-flash-lite now 404s for new keys.
GEMINI_MODEL_NAME=gemini-3.5-flash
# Cheaper/faster model for internal utility work (knowledge-graph extraction).
# Optional — falls back to GEMINI_MODEL_NAME when unset.
GEMINI_UTILITY_MODEL_NAME=gemini-3.5-flash-lite
OPENAI_MODEL_NAME=gpt-5.6
CLAUDE_MODEL_NAME=claude-opus-4-8
GROK_MODEL_NAME=grok-4.5

# Embeddings (platform key, never BYOK). GEMINI_EMBEDDING_DIMENSIONS MUST equal the
# vector(N) width in prisma/schema.prisma. Changing the MODEL invalidates every vector
# already stored — cosine similarity across two embedding spaces is meaningless — so
# re-embed KnowledgeChunk/Analysis rows before switching it.
# gemini-embedding-2 takes 8192 input tokens (vs 2048 for gemini-embedding-001); both
# support outputDimensionality: 768.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# Cache & Security
REDIS_URL=redis://user:password@host:port
JWT_SECRET=your_jwt_secret
COOKIE_SECRET=your_cookie_secret
CSRF_SECRET=your_csrf_secret_min_32_chars

# Encryption
ENCRYPTION_KEY=your_encryption_key_64_hex_chars
ENCRYPTION_SALT=sra-encryption-salt-v1
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_64_hex_chars
BACKUP_ENCRYPTION_SALT=salt

# Vercel (for deployment)
VERCEL_API_TOKEN=your_vercel_api_token

# Dev Flags
MOCK_AI=false
MOCK_QSTASH=false

# RAG Configuration
RAG_SIMILARITY_THRESHOLD=0.25

# Abuse / cost controls (per-user analysis limits). Set to 0 to disable a check.
# Enforcement is skipped automatically when NODE_ENV=test.
MAX_CONCURRENT_ANALYSES=3
MAX_DAILY_ANALYSES=50

# Strict brute-force limit for POST /login and /signup (failed attempts per IP / 15 min).
LOGIN_RATE_LIMIT=10

# Set to 'true' only if you intentionally allow a broad multi-tenant CORS wildcard
# (e.g. https://*.vercel.app). Off by default — broad wildcards are dropped with a warning.
ALLOW_BROAD_CORS_WILDCARD=false
