generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

enum AiProvider {
  GEMINI
  OPENAI
  CLAUDE
  GROK
}

enum AnalysisLifecycleStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// Marks whether a COMPLETED analysis got the full pipeline or the BaseAgent
// rate-limit failsafe (see analysisService.js's "Failsafe: Saving last-known
// draft" path) — previously only visible via the untyped metadata.isPartial flag.
enum AnalysisResultQuality {
  FULL
  PARTIAL
  NONE
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String?
  password  String?
  image     String?
  createdAt DateTime   @default(now())
  // Erasure is a two-step: DELETE /auth/me stamps this and revokes every session
  // immediately (the account is unusable from that moment), then the reconciliation sweep
  // hard-deletes the row and everything cascading from it once the grace window passes.
  // A single irreversible call would mean a stolen token could destroy an account outright.
  deletedAt DateTime?
  // Failed-password counter for the per-account lockout. Kept on the row rather than only
  // in Redis because a lockout that evaporates when the cache restarts is not a lockout,
  // and because credential stuffing spreads across IPs — the per-IP limiter cannot see it.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  accounts             Account[]
  analyses             Analysis[]
  apiKeys              ApiKey[]
  projects             Project[]
  sessions             Session[]
  providerKeys         UserProviderKey[]
  auditLogs            AuditLog[]
  modelQuotas          ModelQuotaState[]
  semanticCacheEntries SemanticPipelineCache[]
  knowledgeChunks      KnowledgeChunk[]
  chatMessages         ChatMessage[]
  qualityMetrics       QualityMetricRecord[]

  @@index([deletedAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  // SHA-256 of the refresh token, never the token itself. Stored in clear text, a database
  // dump was a live session for every user in it — no cracking required, just read and
  // present. The token has 320 bits of entropy from a CSPRNG, so a plain digest is
  // sufficient here; there is no low-entropy secret for an attacker to guess.
  tokenHash  String   @unique
  // The token this one replaced, kept valid until the replacement is known to have arrived.
  // Rotation used to invalidate the old token the instant the new one was written, so a
  // rotation response lost in transit — a closed tab, a dropped mobile connection — left the
  // browser holding a token the server had already retired, and the next refresh signed the
  // user out of a session with days left. See validateSession.
  prevTokenHash      String?  @unique
  successorConfirmed Boolean  @default(true)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  revoked    Boolean  @default(false)
  location   String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Queryable audit trail for sensitive operations.
///
/// These events were emitted to the log stream only. A log stream is evidence during an
/// investigation; it is not a record you can query per-subject, which is what GDPR Art. 30
/// and SOC 2 actually ask for — and what answering "what happened to this account?"
/// requires. Retention is bounded (see reconciliationService) so the trail does not itself
/// become an unbounded store of personal data.
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  status     String   @default("success")
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model ChatMessage {
  id              String   @id @default(uuid())
  analysisId      String
  userId          String?
  role            String
  content         String
  createdAt       DateTime @default(now())
  // Client-generated UUID, one per user send action. processChat upserts on this
  // instead of blind-creating, so a duplicate submit (double-click, retried fetch,
  // browser back/forward replay) can't create a duplicate message pair.
  clientMessageId String?  @unique
  analysis        Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([userId])
}

model Analysis {
  id              String                  @id @default(uuid())
  userId          String
  inputText       String
  resultJson      Json
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  parentId        String?
  rootId          String?
  title           String?
  version         Int                     @default(1)
  projectId       String?
  isFinalized     Boolean                 @default(false)
  metadata        Json?
  vectorSignature Unsupported("vector")?
  status          AnalysisLifecycleStatus @default(COMPLETED)
  resultQuality   AnalysisResultQuality   @default(FULL)
  parent          Analysis?               @relation("AnalysisHistory", fields: [parentId], references: [id])
  children        Analysis[]              @relation("AnalysisHistory")
  project         Project?                @relation(fields: [projectId], references: [id])
  root            Analysis?               @relation("AnalysisRoot", fields: [rootId], references: [id])
  descendants     Analysis[]              @relation("AnalysisRoot")
  user            User                    @relation(fields: [userId], references: [id])
  messages        ChatMessage[]
  knowledgeChunks KnowledgeChunk[]
  qualityMetrics  QualityMetricRecord[]

  @@unique([rootId, version])
  @@index([userId])
  @@index([rootId])
  @@index([parentId])
  @@index([projectId])
  @@index([status])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  access_token      String?
  refresh_token     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Project {
  id          String      @id @default(uuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  settings    Json?
  analyses    Analysis[]
  nodes       GraphNode[]
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KnowledgeChunk {
  id               String                 @id @default(uuid())
  userId           String?
  type             String
  content          Json
  hash             String
  tags             String[]
  sourceAnalysisId String
  createdAt        DateTime               @default(now())
  embedding        Unsupported("vector")?
  metadata         Json?
  qualityScore     Float?
  sourceAnalysis   Analysis               @relation(fields: [sourceAnalysisId], references: [id])
  user             User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([hash])
  @@index([sourceAnalysisId])
  @@index([tags], type: Gin)
}

model GraphNode {
  id            String      @id @default(uuid())
  projectId     String
  name          String
  type          String
  metadata      Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  outgoingEdges GraphEdge[] @relation("SourceNode")
  incomingEdges GraphEdge[] @relation("TargetNode")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name, type])
  @@index([projectId])
  @@index([type])
}

model GraphEdge {
  id        String    @id @default(uuid())
  sourceId  String
  targetId  String
  relation  String
  metadata  Json?
  createdAt DateTime  @default(now())
  source    GraphNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target    GraphNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@index([relation])
}

model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  key       String    @unique
  // What this key may do, enforced by requireScope() in authMiddleware. A key carried full
  // account authority, so a CI token that only ever needs to run `sra check` could also
  // delete every project. Existing keys are backfilled to ["read","write"] — the authority
  // they already had minus destructive operations they were never knowingly granted.
  scopes    String[]  @default(["read", "write"])
  lastUsed  DateTime  @default(now())
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([key])
}

// User-supplied THIRD-PARTY LLM provider keys (bring-your-own-key), distinct from
// ApiKey above which is platform-inbound auth (SHA-256 hashed, never decrypted).
// These are outbound credentials we must decrypt to actually call OpenAI/Claude/Grok,
// so they use the reversible AES-256-GCM helpers in dataEncryption.js instead.
model UserProviderKey {
  id           String     @id @default(uuid())
  userId       String
  provider     AiProvider
  encryptedKey String
  maskedKey    String
  label        String?
  // Generation-capable models discovered when the key was verified (see
  // modelDiscovery.js). Cached so the analysis-creation model picker can offer
  // exactly the models this key can actually use, instead of a hardcoded list.
  availableModels Json?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

/// Where a quota reading came from. The distinction is the whole point of the model: one of
/// these is the provider's own number and one is our arithmetic, and the UI must not present
/// them as equally trustworthy.
enum QuotaSource {
  /// Read from rate-limit response headers. Authoritative, and automatically correct for
  /// whatever tier the key is on — OpenAI (`x-ratelimit-*-requests`) and Anthropic
  /// (`anthropic-ratelimit-requests-*`) both report limit, remaining and reset on every call.
  PROVIDER
  /// Counted by us, because the provider reports nothing. Gemini has no usage endpoint and no
  /// rate-limit headers — its 429 points at the AI Studio dashboard — so the only number
  /// available is how many calls *this platform* made. A key also used elsewhere makes that a
  /// lower bound, never an exact remaining.
  COUNTED
}

/// What we know about a model's remaining allowance, per user, per model.
///
/// Per model rather than per key because that is how the limits are actually enforced: Gemini's
/// RPD is per-model-per-day, and Anthropic/OpenAI publish separate per-model limits. It is also
/// what makes "this one is spent, pick another" a real remedy.
model ModelQuotaState {
  id             String      @id @default(uuid())
  userId         String
  provider       AiProvider
  modelName      String

  source         QuotaSource

  /// Requests allowed in the window. From headers where the provider sends them, otherwise
  /// learned from a 429's `quotaValue` — null until we have seen either.
  requestLimit     Int?
  /// Requests left in the window. Provider-reported only; for COUNTED sources the UI derives
  /// it from `requestLimit - requestsUsed` and labels it as an estimate.
  requestsRemaining Int?
  /// Tokens left in the window, where the provider reports them (Anthropic and OpenAI do).
  tokensRemaining  Int?

  /// Calls made through SRA during `usageDate`; the only signal available for COUNTED sources.
  requestsUsed   Int         @default(0)
  /// The Pacific-time date `requestsUsed` belongs to, as YYYY-MM-DD. Gemini's RPD resets at
  /// midnight Pacific, so rolling the counter on a UTC date would roll it at the wrong moment.
  usageDate      String

  /// Set when the provider said the allowance is spent; cleared once past `resetsAt`.
  exhaustedAt    DateTime?
  /// When the allowance returns: the provider's reset header, or next midnight Pacific for a
  /// per-day quota, or now + `retry-after`.
  resetsAt       DateTime?
  /// The provider's own words for why it refused, shown verbatim rather than paraphrased.
  lastErrorText  String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, modelName])
  @@index([userId])
}

/// Caches the reflection loop's surgical section refinements (DeveloperAgent.refineSRS)
/// across analyses. A regeneration whose target section and feedback are near-duplicates of
/// an earlier one reuses that output instead of paying for another LLM call.
model SemanticPipelineCache {
  id     String @id @default(uuid())
  userId String

  /// One of DeveloperAgent's REFINEMENT_SCHEMAS keys ("Shell" | "Features" | "Requirements" |
  /// "Appendices"), kept as a plain string rather than a duplicated enum — that map is the
  /// single source of truth for which sections are refinable.
  sectionName String

  /// Embeds the exact inputs the refinement was about to send (section content + feedback).
  /// Two entries match only if both agree, which is what makes replaying the cached output
  /// safe rather than merely plausible.
  embedding Unsupported("vector")?

  /// refineSRS's return value, replayed verbatim on a hit.
  output Json

  hitCount  Int      @default(0)
  createdAt DateTime @default(now())
  lastHitAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sectionName])
}

/// Records multi-dimensional 6Cs quality metrics across analysis versions to track
/// rubric fidelity, prompt drift, and LLM provider stability over time.
model QualityMetricRecord {
  id              String   @id @default(uuid())
  analysisId      String
  userId          String
  version         Int
  promptVersion   String
  modelProvider   String
  modelName       String
  overallScore    Float
  clarity         Float
  completeness    Float
  conciseness     Float
  consistency     Float
  correctness     Float
  context         Float
  ragFaithfulness Float?
  createdAt       DateTime @default(now())

  analysis        Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([analysisId, version])
  @@index([userId])
  @@index([promptVersion])
  @@index([createdAt])
}
