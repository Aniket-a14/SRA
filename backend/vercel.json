{
    "version": 2,
    "functions": {
        "api/index.js": {
            "maxDuration": 300
        }
    },
    "rewrites": [
        {
            "source": "/api-docs",
            "destination": "/api/index.js"
        },
        {
            "source": "/api-docs/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/api/index.js"
        }
    ]
}
