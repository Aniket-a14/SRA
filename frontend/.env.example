# Frontend Environment Variables
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Fallback Gemini models shown in the analysis model picker when a saved Gemini key
# hasn't been live-verified (verified keys use the models discovery returns instead).
# Format: comma-separated `id` or `id|Label|Hint`. No model id is hardcoded in the app —
# providers retire models without notice, so this stays configuration.
# Values below were verified callable on a FREE-tier Gemini key on 2026-07-25; every
# *-pro Gemini model returns 429 on the free tier, so none are listed here.
NEXT_PUBLIC_GEMINI_MODELS=gemini-3.5-flash|Gemini 3.5 Flash|Balanced,gemini-3.5-flash-lite|Gemini 3.5 Flash Lite|Fastest,gemini-2.5-flash|Gemini 2.5 Flash|Stable
